[Unit]
Description=biTrader 交易工作台（后端 + 浏览器访问的界面）
Documentation=https://github.com/xiaofengxfc/python_jy/blob/main/docs/DEPLOY-Linux.md
# 网络要先起来；交易所是外网，但本机 127.0.0.1 上的 Caddy 反代也要等网卡就绪
After=network-online.target
Wants=network-online.target
# 崩了要能自动起来，但不能无限重启打满 journal：StartLimit 管住这一条
StartLimitIntervalSec=300
StartLimitBurst=5
# Restart=always 管的是「进程自己崩了」，管不了「代码换了要重新起」：更新是先 git 拉新代码，
# 再让 root 做一次 systemctl --no-block restart bitrader —— 旧进程收 SIGTERM 正常退出（下面
# TimeoutStopSec），systemd 按 ExecStart 把新代码拉起来。这条 restart 只有 root 能做，而服务
# 以 bitrader 跑，于是 deploy/install.sh 在 sudoers 里单授了一条（就这一条，别的命令都没有）：
#   bitrader ALL=(root) NOPASSWD: /usr/bin/systemctl --no-block restart bitrader
# 只允许「--no-block restart」这一个子命令、只对 bitrader 这一个单元。别放宽成 systemctl 通配：
# 那等于把整台机器的服务管理权交给程序用户。
#
# --no-block 不是装饰：默认的 restart 要等本单元停完才返回，而本单元正是发这条命令的进程——
# 老进程等 systemctl、systemctl 等老进程退出，卡到 TimeoutStopSec=20 被 SIGKILL 硬切，
# pip/git 那种跑到一半的收尾也没了。--no-block 把重启交给 systemd 就返回。
# 代价是「到底起来没有」不能在本进程里问，改成新进程自检（core/updater.py::_heal_state 打
# /api/health）：见 docs/DEPLOY-Linux.md §7。

[Service]
Type=simple
User=bitrader
Group=bitrader
WorkingDirectory=/opt/bitrader
# 数据目录：SQLite、配置、日志、secrets.bin 都在这里（不是 $APPAPPDATA，那是 Windows）
Environment=BITRADER_DATA_DIR=/var/lib/bitrader
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# 只监听回环：对外由 Caddy 反代（HTTPS 与跳转都在 Caddyfile 里）
ExecStart=/opt/bitrader/.venv/bin/python run_web.py --host 127.0.0.1 --port 8765
Restart=always
RestartSec=5
# 退出信号给足时间：平仓/撤单这类收尾不该被硬杀
TimeoutStopSec=20
KillSignal=SIGTERM
# 日志直接进 journald（journalctl -u bitrader -f）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bitrader

# ---------------------------------------------------------------- 加固
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# 除了数据目录，整个系统只读：策略文件和 keys 只能落在 /var/lib/bitrader
ReadWritePaths=/var/lib/bitrader
# 这两个开关是给「填域名 → 自动签证书」那一路让路的，别改回去：
#   * NoNewPrivileges=yes 会让 sudo 直接失败，程序就没法执行 /usr/local/lib/bitrader/
#     set-domain.sh（那是唯一一条 NOPASSWD，见 deploy/install.sh 写的 sudoers）；
#   * ProtectSystem=full 把 /etc 也挂成只读，而那个脚本写的就是 /etc/caddy/Caddyfile，
#     root 子进程继承同一套挂载，一样写不进去。
# 让步的边界：那个脚本是 root:root 755、只改 /etc/caddy/Caddyfile 一个文件、自己校验域名、
# caddy validate 不过就还原；除它之外没有第二条 sudo 权限。真正的防线是 sudoers 只授一条命令。
NoNewPrivileges=no
ProtectSystem=yes

[Install]
WantedBy=multi-user.target
