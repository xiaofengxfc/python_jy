# biTrader 的 Caddy 配置模板（install.sh 按域名填好后拷到 /etc/caddy/Caddyfile）
#
# 各段相互独立，按你的情况保留或删掉：
#   1. 全局选项：信任 Cloudflare 边缘，橙云时客户端 IP 才不是同一个
#   2. 站点块：域名 + 自动 HTTPS（Caddy 自己申请、续期证书）
#   3. IP 跳转：用 http://IP 打开的人 301 到域名（IP 拿不到证书，不做 https://IP）
#   4. WebSocket：行情推送走 /ws，说明为什么不用单独配置
#   5. 没有域名时的临时入口（只监听回环 + SSH 隧道）
#
# 下面几处 127.0.0.1 后面的端口会被 install.sh 换成 --port 指定的那个（默认 8765），
# 别在此处改成变量写法：
# Caddyfile 没有变量，install.sh 用的就是 sed。

# ---------------------------------------------------------------- 1. 全局选项
# 域名套了 Cloudflare 橙云时，所有请求都从 CF 边缘过来。不信任 CF 的网段，反代看到的
# remote_host 就是同一个边缘 IP：访问日志里每个客户都长一样，排错时根本分不出是谁。
# trusted_proxies 告诉 Caddy「这些地址是代理」，{client_ip} 才会还原成真实客户端
# （CF 通过 CF-Connecting-IP 传过来）。只列 CF 自己的网段，别人的流量不会被当成代理。
# 网段与 routes_deploy.py 里的内置表同源（https://www.cloudflare.com/ips/），改就两边一起改。
# 整段必须写在一行：Caddyfile 没有续行符，换行就等于指令结束。
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

# ---------------------------------------------------------------- 2. 站点块
trade.example.com {
	# 后端只监听 127.0.0.1:8765，对外一律走这里
	reverse_proxy 127.0.0.1:8765 {
		# 用 {client_ip} 而不是 {remote_host}：橙云下后者是 CF 的边缘 IP。
		header_up X-Real-IP {client_ip}
	}
	# 排错先看这里：/var/log/caddy/access.log
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
	encode gzip zstd
}

# ---------------------------------------------------------------- 3. IP 跳转
# 把 REPLACE_WITH_SERVER_IP 换成服务器公网 IP。没有域名、或者查不到公网 IP 时，
# install.sh 会把这一段整段删掉（只删这一段，别的照写）。
# 只写 http://IP：ACME 不给 IP 签证书，用 IP 访问永远拿不到 HTTPS，所以不开
# https://IP —— 那个站点块在 Caddy 里永远拿不到证书，写了也不会生效。
# 用 IP 打开的人会被 301 到域名，HTTPS 走域名那一块。
http://REPLACE_WITH_SERVER_IP {
	redir https://trade.example.com{uri} 301
}

# ---------------------------------------------------------------- 4. WebSocket
# 行情推送走 /ws，和普通 HTTP 同端口、同站点块：Caddy v2 的 reverse_proxy
# 默认就转发 Upgrade / Connection 头，不需要为 WebSocket 单开一段。
# 只有两件事要注意：
#   * 别在站点块里加 respond / strip 之类会吃掉 Upgrade 头的指令；
#   * 前端在 https 页面上会自动用 wss://，反向代理的超时要放开：
#       reverse_proxy 127.0.0.1:8765 {
#           transport http {
#               read_timeout 0
#           }
#       }
# 验证：浏览器控制台 Network 里看 /ws 是不是 101 Switching Protocols。
# 橙云也支持 WebSocket（免费版就支持），不需要额外配置。

# ------------------------------------------------- 5. 没有域名时的临时入口
# 只监听本机回环，然后在本地机器上开隧道：
#   ssh -N -L 8080:127.0.0.1:8080 你@服务器
# 浏览器打开 http://127.0.0.1:8080 即可（此段不能对公网开放明文界面）。
#127.0.0.1:8080 {
#	reverse_proxy 127.0.0.1:8765
#}
